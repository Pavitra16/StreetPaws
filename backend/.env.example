# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas — free M0 cluster. Atlas specifically (not local mongod),
# because we rely on 2dsphere geo queries and, later, Atlas Vector Search.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/streetdog?retryWrites=true&w=majority

# Cloudinary — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=streetdog

# Google AI Studio — https://aistudio.google.com/apikey (free, no billing account)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Ollama — local vision fallback, used when Gemini is rate-limited or out of
# quota (the free tier allows only 20 vision requests/day).
#   1. Install from https://ollama.com
#   2. ollama pull llava           (or: gemma3, llama3.2-vision, moondream)
#   3. Uncomment the line below
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# Razorpay test mode — https://dashboard.razorpay.com (step 11, not needed yet)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Auth — JWT_SECRET signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email alerts (optional — alerts still appear in the dashboard without this).
# Gmail: use an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StreetPaws <no-reply@streetpaws.local>
