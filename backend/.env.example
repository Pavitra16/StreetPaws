# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas — free M0 cluster. Atlas specifically (not local mongod),
# because we rely on 2dsphere geo queries and, later, Atlas Vector Search.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/streetdog?retryWrites=true&w=majority

# Cloudinary — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=streetdog

# Google AI Studio — https://aistudio.google.com/apikey (free, no billing account)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Ollama — local vision fallback, used when Gemini is rate-limited or out of
# quota (the free tier allows only 20 vision requests/day).
#   1. Install from https://ollama.com
#   2. ollama pull llava           (or: gemma3, llama3.2-vision, moondream)
#   3. Uncomment the line below
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# ---------------------------------------------------------------- Payments
#
# Two gateways are implemented; either can be active. Set PAYMENT_PROVIDER to
# choose when both have keys — otherwise whichever is configured is used.
#
# Razorpay is the right fit for an India-only product (UPI, rupee settlement),
# but its dashboard now requires a PAN before it will issue even test keys.
# Stripe's test mode needs no identity verification, so it is the easier one to
# demo with. Neither takes real money in test mode.
PAYMENT_PROVIDER=stripe

# Stripe — https://dashboard.stripe.com/test/apikeys (no KYC for test mode)
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the dashboard's webhook settings once deployed
STRIPE_WEBHOOK_SECRET=

# Razorpay test mode — https://dashboard.razorpay.com
#
# KEY_ID and KEY_SECRET are the pair from Settings -> API Keys. KEY_ID is the
# rzp_test_... one. These two alone are enough to take payments in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# WEBHOOK_SECRET is NOT issued with the keys above — you invent it. Add a
# webhook at Settings -> Webhooks (URL: https://<your-api>/api/donations/webhook,
# event: payment.captured), type any random string into its Secret field, and
# paste the same string here. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Safe to leave blank locally: Razorpay cannot reach localhost, so no webhook
# ever arrives. Required in production — without it every webhook fails its
# signature check and donations are never marked paid, so money is taken and
# the fund ledger stays at zero.
RAZORPAY_WEBHOOK_SECRET=

# Auth — JWT_SECRET signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email alerts (optional — alerts still appear in the dashboard without this).
# Gmail: use an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StreetPaws <no-reply@streetpaws.local>
